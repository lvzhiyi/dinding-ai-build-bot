# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交。

# 钉钉开发者后台 → 企业内部应用 → 凭证与基础信息
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# Jenkins 地址与专用用户（只授予该 Job 的 Build/Read），API Token 在用户设置页生成
JENKINS_URL=http://jenkins.internal:8080
JENKINS_JOB=course_student_app
JENKINS_USER=dingtalk-bridge
JENKINS_API_TOKEN=

# 白名单：钉钉 staffId，逗号分隔。pro 白名单未配置时任何人都不能打 pro 包。
ALLOWED_STAFF_IDS=
PRO_ALLOWED_STAFF_IDS=
# 可选：只响应这些群（openConversationId），留空表示不限
ALLOWED_CONVERSATION_IDS=

DEFAULT_BRANCH=main
